DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# The developer's own LINE user id — the one person who can read problem
# reports (reports.html). Unset: nobody can, and the page says so. There
# is no LINE_ORGANIZER_USER_ID any more: short-roster alerts go to each
# club's own organizers, looked up in the database.
DEVELOPER_LINE_USER_ID=
# There is no LINE_GROUP_ID. Nothing this project sends goes to a group
# chat — see notify/line_client.py.
# The numeric channel id a LIFF ID token is issued for — the part of the
# LIFF ID before the dash (e.g. LIFF ID 2011156233-6CouG6VI -> 2011156233).
# See api/auth.verify_id_token.
LINE_LIFF_CHANNEL_ID=
# Signs every club's invite link. Required anywhere but local development:
# without it the invite endpoints answer 503 rather than fall back to the
# key written in api/invites.py, which is public. Any long random string —
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Changing it changes every club's link at once.
INVITE_TOKEN_SECRET=
