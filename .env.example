DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_ORGANIZER_USER_ID=
# There is no LINE_GROUP_ID. Nothing this project sends goes to a group
# chat — see notify/line_client.py.
# The numeric channel id a LIFF ID token is issued for — the part of the
# LIFF ID before the dash (e.g. LIFF ID 2011156233-6CouG6VI -> 2011156233).
# See api/auth.verify_id_token.
LINE_LIFF_CHANNEL_ID=
